# Copy to .env.local for local development. .env.local is gitignored.
# Production values live in the Vercel project settings.

# ---------- Postgres ----------
# Local Docker (see docs in commit message): postgres://compcal:dev@localhost:5432/compcal
# Neon free tier: paste the "Connection string" from your Neon dashboard.
POSTGRES_URL=

# ---------- Google OAuth ----------
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI for local: http://localhost:3000/api/auth/callback
# Scopes used by the app: openid, email, profile, calendar.readonly
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- AI providers ----------
# Used by the academic classifier (api/_lib/classify.ts) and check-focus.
# Free tier: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional, only required for /api/roast (Anthropic Claude). Leave blank to
# use the deterministic fallback roast.
ANTHROPIC_API_KEY=

# ---------- App secrets ----------
# AES-256-GCM key for at-rest encryption of Google refresh tokens.
# Generate with: openssl rand -hex 32
REFRESH_TOKEN_KEY=
